# Normalize line endings for text-based source/config files
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.cfg text eol=lf
*.cs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.gitattributes text eol=lf
*.gitignore text eol=lf

# Images
*.png filter=lfs diff=lfs merge=lfs -text
