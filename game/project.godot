; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="[Game Name]"
config/description="A generic AI-first Godot 4.7.2 project."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7")
boot_splash/bg_color=Color(0.0705882, 0.0705882, 0.0705882, 1)
boot_splash/image="res://assets/icons/icon.png"
config/icon="res://assets/icons/icon.png"

[autoload]

McpInteractionServer="*res://autoloads/mcp_interaction_server.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/touchscreen/emulate_touch_from_mouse=true
window/vsync/vsync_mode=1

[gui]

theme/custom_font="res://resources/default_font.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.0705882, 0.0705882, 0.0705882, 1)
